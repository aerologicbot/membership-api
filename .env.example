# --- Supabase (project yang sama dengan aerologicbot-web-app) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:replace-me
# ID grup VIP. Negatif untuk supergroup, contoh: -1001234567890
TELEGRAM_GROUP_ID=-1001234567890
# Username bot tanpa "@" — dipakai membangun link t.me/<bot>?start=<token>
TELEGRAM_BOT_USERNAME=AeroLogicBot
# Secret acak yang dikirim Telegram di header setiap webhook
TELEGRAM_WEBHOOK_SECRET=generate-another-random-secret

# --- Deploy (dipakai docker-compose + Caddy) ---
# Domain yang diarahkan ke IP VPS. Caddy menerbitkan sertifikat untuk domain ini.
DOMAIN=api.aerologic.id

# --- Internal ---
# Melindungi /api/cron/expire, /api/membership/*, dan /api/telegram/invite
CRON_SECRET=generate-a-long-random-secret

# Selama payment gateway belum terpasang, set "true" supaya pendaftaran
# langsung mengaktifkan membership dan user dapat link bot di layar sukses.
# WAJIB dikembalikan ke "false" begitu Midtrans hidup — kalau tidak, siapa pun
# bisa dapat akses grup VIP tanpa membayar.
AUTO_ACTIVATE_ON_REGISTER=false
